From 988a7ed8e2e340214878ef1811f5949b73b45966 Mon Sep 17 00:00:00 2001
From: Josh M <joshlm2947@gmail.com>
Date: Tue, 13 Oct 2026 19:16:55 -0400
Subject: [PATCH 6/7] Emit real memory barriers for sync, lwsync and eieio

They were no-ops, which is close enough on x86 but not on weakly ordered
hosts such as ARM64, where the title's own barriers are what keeps its
lock-free code and publication patterns correct.

---
 XenonRecomp/recompiler.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index cbd32e1..15ce19f 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -891,7 +891,8 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_EIEIO:
-        // no op
+        // Orders stores. The host may be weakly ordered (ARM64), so the barrier has to be real.
+        println("\t__atomic_thread_fence(__ATOMIC_RELEASE);");
         break;
 
     case PPC_INST_EQV:
@@ -1336,7 +1337,8 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_LWSYNC:
-        // no op
+        // Acquire/release barrier. A no-op on x86, dmb ish on ARM64.
+        println("\t__atomic_thread_fence(__ATOMIC_ACQ_REL);");
         break;
 
     case PPC_INST_LWZ:
@@ -1905,7 +1907,7 @@ bool Recompiler::Recompile(
         break;
 
     case PPC_INST_SYNC:
-        // no op
+        println("\t__atomic_thread_fence(__ATOMIC_SEQ_CST);");
         break;
 
     case PPC_INST_TDLGEI:
